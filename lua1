local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local event = ReplicatedStorage:WaitForChild("MovementEvent")

local gui = Instance.new("ScreenGui")
gui.Name = "MovementUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame")
main.Size = UDim2.fromOffset(300, 285)
main.Position = UDim2.new(0.5, -150, 0.5, -142)
main.BackgroundColor3 = Color3.fromRGB(25,25,30)
main.BorderSizePixel = 0
main.Active = true
main.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0,15)
corner.Parent = main

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1,-50,0,50)
title.Position = UDim2.fromOffset(12,0)
title.BackgroundTransparency = 1
title.Text = "⚡ MOVEMENT"
title.TextColor3 = Color3.new(1,1,1)
title.TextSize = 19
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = main

local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(38,38)
close.Position = UDim2.new(1,-46,0,7)
close.BackgroundColor3 = Color3.fromRGB(55,55,65)
close.Text = "X"
close.TextColor3 = Color3.new(1,1,1)
close.TextSize = 15
close.Font = Enum.Font.GothamBold
close.Parent = main

local function makeBox(y, text)
	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(130,40)
	box.Position = UDim2.fromOffset(15,y)
	box.BackgroundColor3 = Color3.fromRGB(42,42,50)
	box.Text = text
	box.TextColor3 = Color3.new(1,1,1)
	box.TextSize = 15
	box.Font = Enum.Font.GothamBold
	box.ClearTextOnFocus = false
	box.Parent = main

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,9)
	c.Parent = box

	return box
end

local function makeButton(y, text)
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(130,40)
	button.Position = UDim2.fromOffset(155,y)
	button.BackgroundColor3 = Color3.fromRGB(55,55,65)
	button.Text = text
	button.TextColor3 = Color3.new(1,1,1)
	button.TextSize = 13
	button.Font = Enum.Font.GothamBold
	button.Parent = main

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,9)
	c.Parent = button

	return button
end

local speedBox = makeBox(65,"100")
local speedButton = makeButton(65,"SPEED: OFF")

local jumpBox = makeBox(120,"100")
local jumpButton = makeButton(120,"JUMP: OFF")

local reset = makeButton(175,"RESET")
reset.Size = UDim2.new(1,-30,0,40)
reset.Position = UDim2.fromOffset(15,175)

local speedOn = false
local jumpOn = false

speedButton.Activated:Connect(function()

	local value = tonumber(speedBox.Text)
	if not value then
		speedBox.Text = "100"
		value = 100
	end

	speedOn = not speedOn

	if speedOn then
		speedButton.Text = "SPEED: ON"
		event:FireServer("Speed",value)
	else
		speedButton.Text = "SPEED: OFF"
		event:FireServer("Speed",16)
	end
end)

jumpButton.Activated:Connect(function()

	local value = tonumber(jumpBox.Text)
	if not value then
		jumpBox.Text = "100"
		value = 100
	end

	jumpOn = not jumpOn

	if jumpOn then
		jumpButton.Text = "JUMP: ON"
		event:FireServer("Jump",value)
	else
		jumpButton.Text = "JUMP: OFF"
		event:FireServer("Jump",50)
	end
end)

reset.Activated:Connect(function()

	speedOn = false
	jumpOn = false

	speedBox.Text = "100"
	jumpBox.Text = "100"

	speedButton.Text = "SPEED: OFF"
	jumpButton.Text = "JUMP: OFF"

	event:FireServer("Reset")
end)

close.Activated:Connect(function()
	main.Visible = false
end)

--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position
	end
end)

UIS.InputChanged:Connect(function(input)

	if not dragging then return end

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

		local delta = input.Position - dragStart

		main.Position = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end
end)

UIS.InputEnded:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false
	end
end)